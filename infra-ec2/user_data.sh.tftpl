#!/bin/bash
set -euxo pipefail

# Amazon Linux 2023 doesn't ship git by default.
dnf install -y git

# Docker's official convenience script installs Engine + the `docker compose`
# plugin in one shot, regardless of which Linux distro the AMI happens to be.
curl -fsSL https://get.docker.com | sh
systemctl enable --now docker

PUBLIC_IP=$(curl -s http://169.254.169.254/latest/meta-data/public-ipv4)

git clone --branch main --depth 1 "https://github.com/${github_repo}.git" /opt/mittyboard
cd /opt/mittyboard

cat > .env <<EOF
DB_PASSWORD=${db_password}
JWT_SECRET_KEY=${jwt_secret_key}
VITE_API_URL=http://$${PUBLIC_IP}:8080
CORS_ALLOWED_ORIGINS=http://$${PUBLIC_IP}:5173
EOF

docker compose up -d --build
