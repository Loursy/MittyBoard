# Copy to terraform.tfvars (gitignored) and fill in, or pass as
# TF_VAR_db_password / TF_VAR_jwt_secret_key / TF_VAR_ssh_public_key
# environment variables so nothing sensitive touches disk in plaintext.

aws_region     = "eu-central-1"
db_password    = "changeme"
jwt_secret_key = "changeme-generate-with-openssl-rand-base64-48"
ssh_public_key = "ssh-ed25519 AAAA... you@yourmachine"

# Restrict this to your own IP before using this for anything real:
# allowed_ssh_cidr = "203.0.113.4/32"

# Optional: serve the app over HTTPS on a real domain instead of http://IP:5173.
# A free DuckDNS subdomain (duckdns.org) works fine here — grab the token from
# your DuckDNS account page.
# domain_name       = "mittyboard.duckdns.org"
# duckdns_token     = "your-duckdns-token"
# letsencrypt_email = "you@example.com"
