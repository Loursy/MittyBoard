# Copy this file to .env and fill in real values before running
# `docker compose up`. Never commit the real .env file.

DB_PASSWORD=changeme
# Generate one with: openssl rand -base64 48
JWT_SECRET_KEY=changeme-generate-a-real-base64-secret

# Only needed if the frontend/backend are exposed on non-default hosts/ports.
# CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# VITE_API_URL=http://localhost:8080
